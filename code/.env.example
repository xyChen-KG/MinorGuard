# Copy to .env, then fill in your own keys. Do not commit or share .env.
TYPESAFE_API_KEY=

# Used by both the visual PIN fallback and the screenshot/JADX checking agent.
# Official DeepSeek vision endpoint (not its dashboard URL).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Optional: use a different model for code checking without changing the collector.
# CHECK_LLM_BASE_URL=https://api.deepseek.com
# CHECK_LLM_API_KEY=
# CHECK_LLM_MODEL=deepseek-flash
